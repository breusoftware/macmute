# Swift Package Manager
.build/
.swiftpm/

# Xcode: keep project files and shared schemes; ignore local/generated state
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
*.xcarchive/
*.xcresult/

# Build output of Scripts/build_app.sh and Scripts/build_dmg.sh
/MacMute.app
/MacMute-*.dmg
/.dmg_staging
/.macmute-app-build.*
/.macmute-dmg-build.*

# macOS
.DS_Store

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Never commit local signing material
*.p12
*.key
*.cer
*.crt
